AEROROUTE_ENVIRONMENT=development
AEROROUTE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional until the live-data/routing integration step. Never put these in frontend env files.
AEROROUTE_OPENAQ_API_KEY=
AEROROUTE_MAPBOX_TOKEN=
AEROROUTE_DATABASE_URL=
AEROROUTE_AWS_REGION=
AEROROUTE_S3_BUCKET=
# Provisional baseline parameters; tune only after reviewing coverage and validation.
AEROROUTE_BASELINE_STATION_RADIUS_METRES=10000
AEROROUTE_BASELINE_MAX_AGE_HOURS=2
# Routing cache hits re-score pollution freshness; version/detour changes invalidate entries.
AEROROUTE_CACHE_TTL_SECONDS=120
# Optional until cloud direction alerts are enabled. Same project as the frontend.
AEROROUTE_FIREBASE_PROJECT_ID=
# Private Admin credential file, never a NEXT_PUBLIC variable or committed file.
# Leave empty to use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
AEROROUTE_FIREBASE_CREDENTIALS_PATH=
