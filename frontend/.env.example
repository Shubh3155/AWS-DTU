# Default: same-origin frontend proxy to this backend URL.
AEROROUTE_API_URL=http://127.0.0.1:8000
# Optional direct browser-to-backend URL; requires matching backend CORS.
NEXT_PUBLIC_API_URL=
# Optional public browser map token.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Public Firebase web-app configuration (all five fields are needed for sign-in/history).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Public Web Push certificate key; optional until cloud alerts are configured.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Local demo-project testing only. Keep false in production.
NEXT_PUBLIC_FIREBASE_EMULATORS=false
