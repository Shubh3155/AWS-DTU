{
  "name": "aeroroute-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "node scripts/build-messaging-worker.mjs --development",
    "prebuild": "node scripts/build-messaging-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:firebase": "firebase emulators:exec --config ../firebase.json --project demo-aeroroute --only auth,firestore 'node scripts/test-firebase.mjs'"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "mapbox-gl": "^3.0.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "15.33.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
